PUBLIC_ORIGIN=https://plugin.maibot.chat
DEVELOPER_DB=/var/lib/maibot-developer/developer.sqlite3
MARKET_SNAPSHOT=/var/lib/maibot-developer-source/market.json
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Fernet.generate_key(), keep private and back up. Rotation invalidates sessions.
ENCRYPTION_KEY=
# secrets.token_urlsafe(48), same value as Worker's DEVELOPER_INGRESS_KEY secret.
INGRESS_KEY=
# Optional rollout switch: when set, exchange OAuth codes through our signed
# Worker endpoint. Use an independent random key matching the Worker Secret.
GITHUB_OAUTH_RELAY_KEY=
